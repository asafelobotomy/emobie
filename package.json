{
  "name": "emobie",
  "private": true,
  "version": "0.6.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:inputd": "cargo test --manifest-path crates/emobie-inputd/Cargo.toml",
    "verify:expand": "bash scripts/verify-expand-setup.sh",
    "smoke:expand": "python3 scripts/smoke-expand-e2e.py",
    "smoke:gate": "npm test && npm run test:inputd && npm run build && bash scripts/check-inputd-packaging.sh && bash scripts/check-loc.sh && npm run verify:expand",
    "stage:inputd": "bash scripts/stage-inputd.sh",
    "icons:user": "bash scripts/install-user-icons.sh",
    "icons:fix-bundle": "bash scripts/fix-linux-bundle-icons.sh",
    "tauri": "tauri",
    "tauri:build": "NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1 tauri build && bash scripts/fix-linux-bundle-icons.sh"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
