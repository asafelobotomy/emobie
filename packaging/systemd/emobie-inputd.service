[Unit]
Description=emobie input helper (text expansion / paste)
Documentation=https://github.com/asafelobotomy/emobie/blob/main/docs/MACROS.md
# Start with the desktop session — not default.target (too early for Wayland).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/emobie-inputd
Restart=on-failure
RestartSec=2
# Runs as the graphical user session so Wayland/X11 inject works.
# Device access for as-you-type is via udev + emobie-input group.
# The daemon waits for $XDG_RUNTIME_DIR/wayland-* if started slightly early.
NoNewPrivileges=true
PassEnvironment=WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_RUNTIME_DIR XKB_DEFAULT_LAYOUT XKB_DEFAULT_MODEL XKB_DEFAULT_VARIANT XKB_DEFAULT_OPTIONS
UMask=0077
RuntimeDirectory=emobie
RuntimeDirectoryMode=0700
PrivateDevices=no
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/emobie
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
