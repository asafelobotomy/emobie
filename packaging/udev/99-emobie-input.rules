# Allow members of emobie-input to use uinput for paste/expansion inject.
KERNEL=="uinput", GROUP="emobie-input", MODE="0660", OPTIONS+="static_node=uinput"
# Keyboards only — do not steal mice/joysticks from the input group.
KERNEL=="event*", SUBSYSTEM=="input", ENV{ID_INPUT_KEYBOARD}=="1", GROUP="emobie-input", MODE="0640"
