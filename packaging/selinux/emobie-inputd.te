module emobie_inputd 1.0;

require {
    type unconfined_t;
    type uinput_device_t;
    class chr_file { open read write ioctl getattr };
}

# Allow the user's emobie-inputd (unconfined user domain) to use uinput for
# paste injection ("Auto-paste on copy"). As-you-type text expansion is
# deferred for now, so no keyboard event-read grant is needed here — see
# docs/MACROS.md "Known limitations". Re-add an `input_device_t` allow rule
# if/when Expand as-you-type returns.
allow unconfined_t uinput_device_t:chr_file { open read write ioctl getattr };
