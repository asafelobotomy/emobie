{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emobie",
  "version": "0.6.7",
  "identifier": "io.github.asafelobotomy.emobie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && bash scripts/stage-inputd.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "emobie",
        "width": 360,
        "height": 480,
        "minWidth": 200,
        "minHeight": 210,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/22x22.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/emobie.desktop",
        "files": {
          "/usr/share/metainfo/io.github.asafelobotomy.emobie.metainfo.xml": "../flatpak/io.github.asafelobotomy.emobie.metainfo.xml",
          "/usr/bin/emobie-inputd": "inputd-bundle/emobie-inputd",
          "/usr/lib/systemd/user/emobie-inputd.service": "inputd-bundle/emobie-inputd.service",
          "/usr/share/emobie/setup-input-access.sh": "inputd-bundle/setup-input-access.sh",
          "/usr/share/emobie/99-emobie-input.rules": "inputd-bundle/99-emobie-input.rules",
          "/usr/share/polkit-1/actions/io.github.asafelobotomy.emobie.inputd.policy": "inputd-bundle/io.github.asafelobotomy.emobie.inputd.policy"
        }
      },
      "rpm": {
        "release": "1",
        "compression": {
          "type": "zstd",
          "level": 3
        },
        "desktopTemplate": "linux/emobie.desktop",
        "files": {
          "/usr/share/metainfo/io.github.asafelobotomy.emobie.metainfo.xml": "../flatpak/io.github.asafelobotomy.emobie.metainfo.xml",
          "/usr/bin/emobie-inputd": "inputd-bundle/emobie-inputd",
          "/usr/lib/systemd/user/emobie-inputd.service": "inputd-bundle/emobie-inputd.service",
          "/usr/share/emobie/setup-input-access.sh": "inputd-bundle/setup-input-access.sh",
          "/usr/share/emobie/99-emobie-input.rules": "inputd-bundle/99-emobie-input.rules",
          "/usr/share/polkit-1/actions/io.github.asafelobotomy.emobie.inputd.policy": "inputd-bundle/io.github.asafelobotomy.emobie.inputd.policy"
        }
      }
    }
  }
}
