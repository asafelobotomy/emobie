{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emobie",
  "version": "0.5.2",
  "identifier": "com.emobie.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emobie",
        "width": 360,
        "height": 480,
        "minWidth": 200,
        "minHeight": 210,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/io.github.asafelobotomy.Emobie.metainfo.xml": "../flatpak/io.github.asafelobotomy.Emobie.metainfo.xml"
        }
      }
    }
  }
}
