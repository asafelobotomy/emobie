{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-is-visible",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "store:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "allow-set-launch-on-startup",
    "allow-is-launch-on-startup",
    "allow-is-tray-available",
    "allow-tray-status",
    "allow-check-for-updates",
    "allow-open-release-page",
    "allow-apply-update",
    "allow-release-single-instance-lock",
    "allow-quit-app",
    "allow-apply-window-pin",
    "allow-pin-capability",
    "allow-input-helper-status",
    "allow-input-helper-set-enabled",
    "allow-input-helper-sync-matches",
    "allow-input-helper-inject-paste",
    "allow-input-helper-ensure-started",
    "allow-input-helper-run-access-setup"
  ]
}
